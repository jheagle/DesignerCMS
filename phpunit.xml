<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         backupGlobals="false"
         bootstrap="tests/bootstrap.php"
         colors="true"
         processIsolation="false"
         stopOnFailure="false"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/11.1/phpunit.xsd"
         cacheDirectory=".phpunit.cache"
         backupStaticProperties="false"
         executionOrder="random"
         displayDetailsOnTestsThatTriggerDeprecations="true"
         displayDetailsOnTestsThatTriggerErrors="true"
         displayDetailsOnTestsThatTriggerNotices="true"
         displayDetailsOnTestsThatTriggerWarnings="true">
  <testsuites>
    <testsuite name="Unit">
      <directory suffix="Test.php">tests/Unit</directory>
    </testsuite>
  </testsuites>
  <php>
    <env name="CACHE_DRIVER" value="array"/>
    <env name="SESSION_DRIVER" value="array"/>
    <env name="QUEUE_DRIVER" value="sync"/>
    <env name="APP_DEBUG" value="false"/>
    <env name="APP_ENV" value="testing"/>
    <!-- The MySQL test database (user and password from .env); tests never use the app's own database -->
    <env name="DB_CONNECTION" value="mysql"/>
    <env name="DB_DATABASE" value="designercms_test"/>
    <env name="DB_HOSTNAME" value="localhost"/>
    <env name="TESTING" value="false"/>
    <env name="PRODUCTION" value="true"/>
    <!-- Tests log here (emptied at the start of each run by tests/bootstrap.php), never to logs/all.log -->
    <env name="LOG_FILE" value="logs/test.log"/>
    <env name="FILESYSTEM_DRIVER" value="testing"/>
  </php>
  <source>
    <include>
      <directory suffix=".php">app</directory>
      <directory suffix=".php">tests/Traits</directory>
    </include>
  </source>
</phpunit>
